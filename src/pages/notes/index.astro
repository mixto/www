---
import Layout from '@layouts/Layout.astro'
import { getCollection } from 'astro:content'

const notes = await getCollection('notes')
---

<Layout title="Notes">
  <h1>Notes!</h1>
  <ul>
    {notes.map((note) => (
      <li>
        <a href={`notes/${note.id}`}>
          {note.data.title}
        </a>
      </li>
    ))}
  </ul>
</Layout>
